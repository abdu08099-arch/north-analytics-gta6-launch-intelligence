# Copy to .env and fill in locally. Never commit .env.
# In GitHub Actions, set these as repository secrets instead.
# Placeholders only: no real values in this file.

# Environment: development | production
APP_ENV=development

# Database (local default: SQLite file; production: PostgreSQL URL)
DATABASE_URL=sqlite:///data/gta6.db

# Phase 3, only if approved (see docs/data/source-register.md)
YOUTUBE_API_KEY=
X_BEARER_TOKEN=

# Google Trends API alpha, only if access is granted
GOOGLE_TRENDS_API_KEY=

# Reddit is blocked (Decision 0003). Kept for reference; leave empty.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
